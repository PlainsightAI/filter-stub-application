# FILTER_DEBUG=False # True, False
# Output mode: echo replays a file, random is the legacy fuzzer, realistic is the draft-07 generator
# FILTER_OUTPUT_MODE=random # echo, random, realistic
# Path to save generated output
# FILTER_OUTPUT_JSON_PATH="./output/output.json"
# Path to read events from in echo mode
# FILTER_INPUT_JSON_EVENTS_FILE_PATH="./input/events.json"
# Path for schema / template in random and realistic modes
# FILTER_INPUT_JSON_TEMPLATE_FILE_PATH="./input/events_template.json"
# FILTER_PROCESS_PROFILE_PATH="./inputs/process_profile.example.json"
# FILTER_FORWARD_UPSTREAM_DATA=true
# FILTER_FORWARD_IMAGES=false
# FILTER_TRIGGER_MODE=image # image, process (realistic only)
# FILTER_EMIT_EVERY_N_FRAMES=1
# FILTER_EVENT_TOPIC=main
# FILTER_FRAME_EVENT_KEY=event
# FILTER_FRAME_EVENT_COLLISION=error # error, overwrite, skip
# FILTER_APPEND_OUTPUT=false
# FILTER_FAILURE_POLICY=drop # drop, stop
# FILTER_IO_FAILURE_POLICY=stop # stop, drop
# FILTER_REALISTIC_SEED=0
# FILTER_REALISTIC_OPTIONAL_PROBABILITY=0.5
# FILTER_REALISTIC_NULL_PROBABILITY=0.1
# FILTER_REALISTIC_EXAMPLE_PROBABILITY=0.3
# FILTER_REALISTIC_MAX_ATTEMPTS=20
# FILTER_REALISTIC_MAX_DEPTH=32
# FILTER_REALISTIC_MAX_NODES=10000
# FILTER_REALISTIC_MAX_EVENT_BYTES=1048576
# FILTER_REALISTIC_PREFLIGHT_SAMPLES=10
# FILTER_REALISTIC_ARRAY_MAX_WHEN_UNBOUNDED=3
# FILTER_REALISTIC_NUMBER_BOUND_WHEN_UNBOUNDED=1000
# FILTER_TYPE_WEIGHTS={"string":1,"integer":1}
# FILTER_PROCESS_TICK_SECONDS=1.0
# Realistic compose pipeline (docker-compose.realistic.yaml / make run-realistic)
# LOG_LEVEL=INFO
# VIDEO_PATH=./data/sample-video.mp4
# WEBVIS_PORT=8001
